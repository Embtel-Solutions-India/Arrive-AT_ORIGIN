NODE_ENV=production
PORT=4000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.hmicz9o.mongodb.net/soulbody?retryWrites=true&w=majority

# Origins allowed to call the API with credentials (comma separated)
CORS_ORIGINS=https://arriveatorigin.com,https://www.arriveatorigin.com,http://localhost:5173
APP_URL=https://arriveatorigin.com
API_URL=https://api.arriveatorigin.com

# Authentication & JWT
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=1
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
COOKIE_DOMAIN=

# Initial Seed Super Admin
SEED_ADMIN_EMAIL=admin@arriveatorigin.com
SEED_ADMIN_PASSWORD=ChangeMe!123456

# Payments (Razorpay / Stripe)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
PAYMENT_WEBHOOK_SECRET=

# File Uploads & S3-compatible Object Storage
UPLOAD_DIR=uploads
AWS_S3_BUCKET=aao-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email Delivery & SMTP (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Arrive at Origin <info@arriveatorigin.com>
EMAIL_REPLY_TO=info@arriveatorigin.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
